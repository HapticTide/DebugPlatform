# =============================================================================
# DebugPlatform Docker 部署环境变量模板
#   cp deploy.docker.env.example .env  然后改掉所有密码/Token
#   .env 不要提交到 Git
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=debug_hub
# 改成强随机值，例如: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=debug_hub

# --- 设备连接鉴权 ---
# 探针 SDK 连接 /debug-bridge 时校验该 Token；公网部署必须改掉
# 生成: openssl rand -hex 32
DEBUG_HUB_TOKEN=CHANGE_ME_random_token

# --- 可选：Cloudflare Tunnel ---
# 在 Cloudflare Zero Trust > Networks > Tunnels 创建后获取
# 启用方式: docker compose --profile cloudflared up -d
CF_TUNNEL_TOKEN=
